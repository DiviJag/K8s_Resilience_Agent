# OpenRouter key used by the Diagnostician (HLD §15: agent reasoning via OpenRouter / InsForge key)
OPENROUTER_API_KEY=

# Model the agent reasons with, e.g. anthropic/claude-sonnet-4.5 or openai/gpt-4.1-mini
CHAOSLOOP_MODEL=anthropic/claude-sonnet-4.5

# Reserved for the Phase 2 root-cause LLM-as-judge; must differ from CHAOSLOOP_MODEL (HLD §7.1)
CHAOSLOOP_JUDGE_MODEL=

# Track B only - kubeconfig for the kind lab cluster. Leave this commented out to use the
# default (~/.kube/config): an empty value is read as a literal empty path, not as "unset".
# KUBECONFIG=
